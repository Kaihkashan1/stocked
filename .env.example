# Copy this file to .env and fill in the values.
#   cp .env.example .env

# Required — from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override. gemini-3.6-flash is the current free-tier workhorse
# for video + JSON. Check https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.6-flash

# Required — the long id in the Sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=

# Path to the JSON key you download for the Google Cloud service account.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# On Vercel, paste the JSON key as a single env var instead of a file:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Shared secret the iPhone Shortcut sends as header X-Recipe-Box-Key.
# Pick any random string; keep it private.
RECIPE_BOX_SECRET=change-me

# Optional — fetches Instagram posts/reels through a paid Apify actor
# instead of yt-dlp + your personal login cookies. No Instagram account is
# ever authenticated, so this carries no risk of your account being flagged
# or restricted (see README). Falls back to the cookies below when unset or
# when the actor call fails.
# APIFY_API_TOKEN=
# APIFY_INSTAGRAM_ACTOR=apidojo~instagram-scraper-api

# Instagram login cookies — used only as a fallback when APIFY_API_TOKEN is
# unset (or that fetch fails). Export only instagram.com cookies into this
# file (see README). Leave cookies-from-browser unset so Safari is never read.
YTDLP_COOKIES_FILE=./instagram_cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=
# On Vercel, paste the Netscape cookie file contents:
# YTDLP_COOKIES=

# Optional — free push notifications via https://ntfy.sh
# Create a unique topic name and subscribe to it in the ntfy app.
# NTFY_TOPIC=recipe-box-yourname
